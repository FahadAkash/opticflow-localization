{
  "annotations": { "list": [] },
  "editable": true,
  "title": "OptiFlow — Localization & AI Telemetry",
  "uid": "optiflow-overview",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "AI Tokens Processed (optiflow.ai.tokens)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(optiflow_ai_tokens_total[5m]))" }]
    },
    {
      "id": 2,
      "title": "Approved TM Cache/DB Hits (optiflow.tm.hits)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(optiflow_tm_hits_total)" }]
    },
    {
      "id": 3,
      "title": "AI Latency p50 / p95 / p99 (optiflow.ai.latency_ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(optiflow_ai_latency_ms_bucket[5m])) by (le))" },
        { "expr": "histogram_quantile(0.95, sum(rate(optiflow_ai_latency_ms_bucket[5m])) by (le))" },
        { "expr": "histogram_quantile(0.99, sum(rate(optiflow_ai_latency_ms_bucket[5m])) by (le))" }
      ]
    }
  ]
}
